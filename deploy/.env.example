# Copy to /opt/instant/.env on the VPS (bootstrap.sh does this) and fill in.
# Never commit the real file.

# Public hostnames; both need A/AAAA records pointing at the VPS.
DASH_DOMAIN=demo.example.com
API_DOMAIN=api.demo.example.com
ACME_EMAIL=you@example.com

# Generated by bootstrap.sh.
POSTGRES_PASSWORD=

# Image tag to run; the deploy workflow sets this to the commit sha.
IMAGE_TAG=latest
IMAGE_REPO=ghcr.io/gratefulworkspace/instantdb-rust

# Dashboard access. `restricted` admits only the emails below until the
# public launch flips it to `open`.
INSTANT_SUPERUSER_EMAIL=you@example.com
INSTANT_DASHBOARD_SIGNUP_MODE=restricted
INSTANT_DASHBOARD_ALLOWED_EMAILS=you@example.com

# Demo limits (defaults in compose.yml): per-app size, apps per user, and
# how long a deleted app can be restored before it is purged.
# INSTANT_APP_SIZE_LIMIT_MB=10
# INSTANT_MAX_APPS_PER_USER=3
# INSTANT_HARD_DELETE_GRACE_HOURS=2

# No email provider yet: magic codes are printed to the server log
#   docker compose logs server | grep -i code
EMAIL_PROVIDER=log

# Dashboard Google login (needed before signup goes `open`). Redirect URI:
#   https://$API_DOMAIN/dash/oauth/callback
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=
