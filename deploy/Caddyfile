# TLS is automatic (Let's Encrypt) once DNS for every name below points here.
{
	email {$ACME_EMAIL}
}

# Marketing site: static files from web/dist, uploaded by the deploy workflow.
{$SITE_DOMAIN} {
	encode zstd gzip
	root * /srv/site
	# Vite fingerprints everything under /assets.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$DASH_DOMAIN} {
	encode zstd gzip
	reverse_proxy dashboard:3000
}

{$API_DOMAIN} {
	# Prometheus metrics stay off the public internet.
	respond /metrics 404
	# SSE needs unbuffered streaming; websockets upgrade automatically.
	reverse_proxy /runtime/sse* server:8888 {
		flush_interval -1
	}
	reverse_proxy server:8888
}
